' Shared look for the sequence diagrams: the app's greens on white, for reading.
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 4
skinparam ArrowColor #1C382C
skinparam ArrowFontColor #26332C
skinparam SequenceLifeLineBorderColor #9AA093
skinparam SequenceGroupBorderColor #3C6850
skinparam SequenceGroupBackgroundColor #EEF2EE
skinparam SequenceGroupHeaderFontColor #1C382C
skinparam SequenceBoxBorderColor #C9CFC9
skinparam NoteBackgroundColor #FFF6EE
skinparam NoteBorderColor #9A4F2D
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #3C6850
skinparam ParticipantFontColor #1C382C
skinparam ParticipantFontStyle bold
skinparam ActorBorderColor #3C6850
skinparam ActorBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #EEF2EE
skinparam DatabaseBorderColor #1C382C
skinparam sequenceMessageAlign left
autonumber "<b>0."
