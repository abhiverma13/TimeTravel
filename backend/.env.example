# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB. docker compose overrides this with its bundled mongo service.
MONGODB_URI=mongodb://localhost:27017/timetravel

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Signs TimeTravel session tokens. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_string

# Google Places API (New) key for the activity catalogue. Without it, only cities
# already stored in MongoDB (e.g. via `npm run seed:demo`) can be browsed.
GOOGLE_PLACES_API_KEY=

# OpenWeather key for the forecast checks on trips under way (rain on outdoor stops). Without it,
# only closed venues are checked.
OPENWEATHER_API_KEY=

# Leave blank for local HTTP development. Set both paths on the cloud VM to
# serve HTTPS; use PORT=443 in that production configuration.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Other API keys, secrets, and configurations
