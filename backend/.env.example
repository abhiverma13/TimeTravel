# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB. docker compose overrides this with its bundled mongo service.
MONGODB_URI=mongodb://localhost:27017/timetravel

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Signs TimeTravel session tokens. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_string

# Leave blank for local HTTP development. Set both paths on the cloud VM to
# serve HTTPS; use PORT=443 in that production configuration.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Other API keys, secrets, and configurations
